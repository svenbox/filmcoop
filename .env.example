# Google OAuth (skapas i Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Sheets service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=          # hela nyckeln inkl \n, citationstecken runt värdet

# Valfritt: kalkylbladet för det första projektet. Används bara första gången
# portalen startar, för att skapa ett projekt automatiskt. Därefter hanteras
# projekt på /admin.
SPREADSHEET_ID=

# NextAuth
NEXTAUTH_SECRET=             # generera med: openssl rand -base64 32
NEXTAUTH_URL=https://din-domän.se

# Kommaseparerade e-postadresser som får använda /admin (lägga till och ta bort
# projekt). Om tom används PRODUCER_EMAILS.
ADMIN_EMAILS=

# Valfritt: producenter för det första projektet (se SPREADSHEET_ID ovan).
PRODUCER_EMAILS=

# Visas i UI (valfritt)
PROJECT_NAME=film.coop
